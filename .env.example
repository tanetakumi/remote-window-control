# Optional .env beside the executable, or in the repository root during development.
# Environment variables override these literal KEY=VALUE entries.
SHARE_APP_ADDR=127.0.0.1:8443

# Session keep-alive: RDP credentials of the same Windows user that runs
# share-host. Used only by the keep-alive toggle in the web UI, which
# connects to 127.0.0.1:3389.
SHARE_APP_RDP_USERNAME=
SHARE_APP_RDP_PASSWORD=
